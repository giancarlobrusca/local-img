{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "local-img",
  "version": "0.1.0",
  "identifier": "com.giancarlobrusca.local-img",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["python/**/*"],
    "shortDescription": "Local text-to-image generation",
    "longDescription": "Prompt in a window, PNG out. No API keys, no cloud, no content filtering. Runs on your own GPU and works offline once the weights are downloaded."
  }
}
